APP_NAME=EcoConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=econnect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Notifications, emails, location validation and auto-reject are all queued.
# The application does not work correctly without a running queue worker:
#   php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ecoconnect.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Web push notifications (required)
# --------------------------------------------------------------------------
# Generate a VAPID key pair once, then keep it stable — rotating it invalidates
# every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --------------------------------------------------------------------------
# Firebase (optional)
# --------------------------------------------------------------------------
# Path to the service account JSON, relative to the project root.
FIREBASE_CREDENTIALS=storage/app/firebase-auth.json

# --------------------------------------------------------------------------
# Incident handling
# --------------------------------------------------------------------------
# Pending incidents older than this are rejected automatically by the
# incidents:auto-reject command, which requires a running scheduler:
#   php artisan schedule:work
INCIDENT_AUTO_REJECT_DAYS=30
INCIDENT_AUTO_REJECT_NOTIFICATIONS=true
INCIDENT_BATCH_SIZE=50

# --------------------------------------------------------------------------
# Seed accounts (local and staging only)
# --------------------------------------------------------------------------
# Used by UserSeeder. Passwords are required when seeding in production; outside
# production a known fallback is used and announced by the seeder.
SEED_ADMIN_EMAIL=admin@ecoconnect.test
SEED_ADMIN_PASSWORD=
SEED_POLICE_EMAIL=police@ecoconnect.test
SEED_POLICE_PASSWORD=
SEED_BFP_EMAIL=bfp@ecoconnect.test
SEED_BFP_PASSWORD=
SEED_CITIZEN_EMAIL=citizen@ecoconnect.test
SEED_CITIZEN_PASSWORD=
